---
import '../styles/global.css';
import ChessGame from '../components/ChessGame.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chess Risk</title>
    <script is:inline>
      // Set the theme from the device setting before the page paints.
      document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: light)').matches
        ? 'light'
        : 'dark';
    </script>
  </head>
  <body>
    <header>
      <h1>Chess Ideas</h1>
      <p>A small gift.</p>
    </header>
    <main>
      <ChessGame />
    </main>
    <footer><p>A website which lets you play variants of chess inspired by the board game risk. Made for my best friend.</p></footer>
  </body>
</html>

